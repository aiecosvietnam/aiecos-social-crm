# ═══════════════════════════════════════════════════════════════
#  Root .env — for docker compose
#  Copy: cp .env.example .env  then edit values
# ═══════════════════════════════════════════════════════════════

# Strong shared secret (Chrome extension ↔ sync receiver)
# Generate: openssl rand -hex 32
API_TOKEN=dev-token-change-me-in-prod

# Supabase target — choose ONE of:
#
# A) DEV (default) — use bundled postgres + postgrest in this compose
#    Leave these commented; defaults in docker-compose.yml work.
#
# B) PRODUCTION (recommended) — point at real Supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGciOi...your-service-role-key
# SUPABASE_SCHEMA=aiecos_social
