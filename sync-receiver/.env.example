# ── Sync Receiver Configuration ──
PORT=3500

# Strong shared secret between Chrome extension and this server
# Generate: openssl rand -hex 32
API_TOKEN=replace-with-a-strong-random-string

# ── Supabase target ──
# Self-host: http://supabase-kong:8000 (when running on same Docker network)
# Cloud: https://your-project.supabase.co
SUPABASE_URL=http://supabase-kong:8000

# Service role key (NOT anon key — needs schema write access)
SUPABASE_SERVICE_KEY=eyJhbGciOi...replace-with-your-service-role-key

# Schema name (create this schema in Postgres + expose via PostgREST DB_SCHEMAS env)
SUPABASE_SCHEMA=aiecos_social

# ── Production hardening (optional, sensible defaults) ──
# CORS allowed origin (default *). For prod set to your admin UI domain.
CORS_ORIGIN=*

# Rate limit on /api/sync — req per window per IP+token
RATE_WINDOW_MS=60000
RATE_MAX=300
